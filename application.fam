App(
    appid="lan_tester",
    name="Bad-RJ",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="hacker_screen_app",
    stack_size=4 * 1024,
    fap_category="GPIO",
    fap_icon="assets/icon.png",
    fap_icon_assets="assets",
    fap_author="Dok2d, nullsp3ct0r & WhiteCatto",
    fap_version="2.9.0",
    fap_description="Portable LAN tester & security analyzer: ARP, ping, DHCP, LLDP/CDP, port scan, SNMP, NTP sync, IPMI, TFTP, PXE download, 802.1X, VLAN, rogue DHCP/RA detection via W5500",
    fap_weburl="https://github.com/WhiteCatto/Bad-RJ",
    sources=["*.c*", "!docs"],
    requires=[
        "gui",
        "notification",
    ],
    fap_private_libs=[
        Lib(
            name="ioLibrary_Driver",
            fap_include_paths=[
                "Ethernet/W5500",
                "Ethernet",
                "Internet/DHCP",
            ],
            sources=[
                "Ethernet/W5500/*.c",
                "Ethernet/*.c",
                "Internet/DHCP/*.c",
            ],
        ),
    ],
)
